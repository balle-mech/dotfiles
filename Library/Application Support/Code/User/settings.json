  // ===========================================
  // ================= Java ==================
  "java.project.sourcePaths": ["src"],
  "java.project.outputPath": "bin",
  "java.project.referencedLibraries": ["src/main/webapp/WEB-INF/lib/*.jar"],
  // ================= latex =================
  "[tex]": {
    // スニペット補完中にも補完を使えるようにする
    "editor.suggest.snippetsPreventQuickSuggestions": false,
  },
  "[latex]": {
    // スニペット補完中にも補完を使えるようにする
    "editor.suggest.snippetsPreventQuickSuggestions": false,
  },
  // ---------- LaTeX Workshop ----------
  // 使用パッケージのコマンドや環境の補完を有効にする
  "latex-workshop.intellisense.package.enabled": true,
  // 生成ファイルを削除するときに対象とするファイル
  // デフォルト値に "*.synctex.gz" を追加
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.ist",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.snm",
    "*.nav",
    "*.dvi",
    "*.synctex.gz",
  ],
  // 生成ファイルを "out" ディレクトリに吐き出す
  "latex-workshop.latex.outDir": "out",
  // ビルドのレシピ
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": ["latexmk"],
    },
  ],
  // ビルドのレシピに使われるパーツ
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": ["-silent", "-outdir=%OUTDIR%", "%DOC%"],
    },
  ],
  // ==========================================
  // ================= Ruby =================
  // Rubyのlint tool
  "ruby.rubocop.executePath": "/usr/local/bundle/bin/rubocop",
  "rubyLsp.rubyVersionManager": {
    "identifier": "none",
  },
  "rubyLsp.formatter": "rubocop",
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
  },
  "ruby.useLanguageServer": true,
  "ruby.lint": "rubocop",
  "ruby.format": "rubocop",
  // rails ⌘ + クリックでクラスの定義元に移動
  "ruby.intellisense": "rubyLocate",
  // rubocop
  "ruby.rubocop.onSave": false,
  // ==========================================
  // ================= Python =================
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  // Pythonのlint tool
  "python.linting.enabled": true, // Lintの有効化
  "python.linting.pylintEnabled": false, // pylintの無効化
  "python.linting.flake8Enabled": true, // flake8の有効化
  "python.linting.lintOnSave": false, // ファイル保存時のlint実行
  "python.formatting.provider": "autopep8", // フォーマッタにautopep8
  "python.linting.flake8Args": ["--ignore=E501"], // 1行の文字数制限を無視
  // codic
  "codic.ACCESS_TOKEN": "tTvX3RbwExFTy0PENGeLjXWZzsgYGaBzCG",
  "workbench.colorTheme": "Dark+",
  "git.autofetch": true,
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.editorAssociations": {
    "*.db": "default",
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "techtrain-railway.optOutTelemetry": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "git.confirmSync": false,
  "liveServer.settings.donotVerifyTags": true,
  "workbench.iconTheme": "material-icon-theme",

  // 参考になるサイト
  // https://qiita.com/WGG_SH/items/82f83ba91ca0d7f5c8b7
  // 新規ファイルはUntitledでファイル作成
  "workbench.startupEditor": "newUntitledFile",
  // ミニマップの表示
  "editor.minimap.enabled": false,
  // タブ
  "editor.tabSize": 2,
  "[markdown]": {
    "editor.tabSize": 2,
    "editor.detectIndentation": false,
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.indentSpaces": true,
  },
  // 入力補完を表示する
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on",
    "other": "on",
  },
  // 選択中の行を強調する
  "editor.renderLineHighlight": "all",
  // ウインドウ幅で折り返す
  "editor.wordWrap": "on",
  // 選択範囲の角を丸める
  "editor.roundedSelection": false,
  // オートインデント
  "editor.autoIndent": "keep",
  // 余分なホワイトスペースを削除
  "files.trimTrailingWhitespace": true,
  // ファイルの末尾は改行で終わらせる
  "files.insertFinalNewline": true,
  // パンくず
  "breadcrumbs.enabled": true,
  // 空白文字の表示
  "editor.renderWhitespace": "all",
  // ファイルのドラックアンドドロップの誤り警告
  "explorer.confirmDragAndDrop": false,
  // 削除の警告無視
  "explorer.confirmDelete": false,
  // Prettier (保存時にコードを整える)
  "editor.formatOnSave": true,
  "editor.guides.indentation": false,
  // ============================ vue ============================
  "[vue]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
    },
  },
  // javascript import設定
  "javascript.suggest.autoImports": true,
  "typescript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "codic.case": "snake_case",
  "eslint.format.enable": false,
  "[javascript]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
